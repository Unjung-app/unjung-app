{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "icn1"
  ],
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|_expo/|assets/|privacy).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/**": false
    }
  }
}

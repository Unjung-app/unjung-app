{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "icn1"
  ],
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "EXPO_PUBLIC_BUILD_ID=$VERCEL_GIT_COMMIT_SHA npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|_expo/|assets/|privacy).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-school",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "api/push/send.ts": {
      "maxDuration": 60
    }
  }
}

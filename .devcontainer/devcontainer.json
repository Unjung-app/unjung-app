// GitHub Codespaces(브라우저에서 바로 쓰는 개발 환경) 설정
// → 설치 없이 GitHub 저장소 화면의 [Code] → [Codespaces] → [Create codespace] 로 시작합니다.
{
  "name": "운중고 앱",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // 처음 만들 때 한 번: 부품 설치 (package-lock.json 변동은 되돌림)
  // updateContentCommand 는 끝날 때까지 기다린 뒤 편집기가 열리므로, 앱 자동 실행보다 먼저 끝납니다.
  "updateContentCommand": "npm install --no-audit --no-fund --loglevel=error && git checkout -- package-lock.json",

  // 앱 주소(3000번)를 자동으로 연결하고, 편집기 옆에 미리보기를 엽니다.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "운중고 앱", "onAutoForward": "openPreview" }
  },

  "customizations": {
    "vscode": {
      "settings": {
        // 폴더를 열면 앱이 자동으로 켜지도록 (.vscode/tasks.json)
        "task.allowAutomaticTasks": "on",
        // 저장(Ctrl+S)을 잊어도 1초 뒤 자동 저장
        "files.autoSave": "afterDelay",
        "workbench.startupEditor": "none",
        "editor.wordWrap": "on",
        "git.openRepositoryInParentFolders": "never"
      }
    }
  }
}
